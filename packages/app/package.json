{
  "name": "@airlock/app",
  "version": "0.8.0",
  "description": "Terminal-first AI IDE where the agent can't read your secrets",
  "author": "Ricardo Ramos Treviño",
  "license": "SEE LICENSE IN LICENSE.md",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --dir && node build/sign-airlock.cjs",
    "package:dev": "AIRLOCK_DEV_UPDATE=1 electron-vite build && electron-builder --dir && node build/sign-airlock.cjs && node build/write-dev-manifest.cjs",
    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.ricardoramos.airlock",
    "productName": "AirLock",
    "electronVersion": "42.3.2",
    "protocols": [
      {
        "name": "AirLock OAuth",
        "schemes": [
          "airlock"
        ]
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**"
    ],
    "asarUnpack": [
      "out/main/atlasDbHost.js",
      "out/main/chunks/**",
      "node_modules/node-pty/**",
      "node_modules/@parcel/watcher/**",
      "node_modules/@parcel/watcher-darwin-arm64/**"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE.md",
        "to": "LICENSE.md"
      },
      {
        "from": "../../COMMERCIAL.md",
        "to": "COMMERCIAL.md"
      },
      {
        "from": "../../node_modules/electron/dist/LICENSE",
        "to": "third-party/electron-LICENSE.txt"
      },
      {
        "from": "../../node_modules/electron/dist/LICENSES.chromium.html",
        "to": "third-party/LICENSES.chromium.html"
      },
      {
        "from": "resources/mcp-docs",
        "to": "mcp-docs"
      },
      {
        "from": "../../node_modules/typescript",
        "to": "ts-lib"
      },
      {
        "from": "../../node_modules/typescript-language-server",
        "to": "lsp-server"
      },
      {
        "from": "resources/statusline-emit.sh",
        "to": "statusline-emit.sh"
      },
      {
        "from": "resources/eslint-worker.mjs",
        "to": "eslint-worker.mjs"
      },
      {
        "from": "resources/claude-skills",
        "to": "claude-skills"
      },
      {
        "from": "resources/airlock-dock-status.sh",
        "to": "airlock-dock-status.sh"
      },
      {
        "from": "resources/dock",
        "to": "dock"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "AirLock-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/merge": "^6.12.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@parcel/watcher": "^2.5.6",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@replit/codemirror-minimap": "^0.5.2",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "@vscode/codicons": "^0.0.45",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.2",
    "node-pty": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.3.0",
    "vscode-jsonrpc": "^9.0.0",
    "vscode-languageserver-protocol": "^3.18.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5"
  }
}
